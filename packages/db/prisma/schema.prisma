generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum ProblemSource {
  UVA
  CPE
  GPE
  CUSTOM
}

enum CheckerType {
  EXACT
  IGNORE_TRAILING_WS
  FLOAT
  SPECIAL
}

enum Verdict {
  PENDING
  JUDGING
  AC
  WA
  TLE
  MLE
  RE
  RF
  CE
  PE
  OLE
  SE
}

enum JudgedOn {
  SELF
  REMOTE
}

enum ContestKind {
  CPE
  GPE
  VIRTUAL
  PUBLIC
}

enum ScoringMode {
  ICPC
  SUBTASK
}

enum ParticipantStatus {
  REGISTERED
  RUNNING
  FINISHED
}

enum Plan {
  FREE
  PRO
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  /// Credit-card order only: ECPay confirmed the card authorization succeeded (hold placed, not
  /// yet captured). Pro is already granted at this point — see billing.service.markCreditAuthorized
  /// — capture is done manually later via ECPay's own merchant backend, at the operator's pace.
  AUTHORIZED
  APPROVED
  REJECTED
  /// Set by billing.service.requestRefund once ECPay confirms the refund/void actually went
  /// through — a terminal state like APPROVED/REJECTED, never transitions further.
  REFUNDED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  handle       String   @unique
  email        String   @unique
  passwordHash String?
  emailVerifiedAt DateTime?
  /// Durable credential generation: pre-reset JWTs cannot be revived by Redis races.
  authVersion Int @default(0)
  mfaSecretEncrypted String?
  mfaEnabledAt DateTime?
  mfaLastStep Int?
  mfaRecoveryHashes String[] @default([])
  googleId     String?  @unique
  role         Role     @default(USER)
  /// Set by an admin to mark this account as one of their actual tutoring students (distinct
  /// from role=USER, which now also covers anyone who self-registered out of general interest).
  /// Gates the "My Classes" nav link and Class-tracking features.
  isStudent    Boolean  @default(false)
  /// Billing tier. FREE users are capped (submit quota + virtual-attempt count); PRO lifts both.
  /// PRO is only "active" while planExpiresAt is in the future — past that the account behaves as
  /// FREE again until another payment extends the date (see billing.service).
  plan            Plan      @default(FREE)
  planExpiresAt   DateTime?
  /// Set when a PRO user without an active Subscription (a one-time ATM/admin-granted period) asks
  /// to downgrade. Purely informational — that Pro time is already paid for, so this doesn't change
  /// enforcement at all; it only lets the UI keep showing "you chose to downgrade" after a reload
  /// instead of forgetting on refresh. Cleared automatically the next time extendPlan runs (buying
  /// more Pro is an unambiguous signal they no longer want to downgrade). A user WITH an active
  /// Subscription cancels through that model instead (billing.service.cancelSubscription), which
  /// downgrades immediately rather than waiting out the paid period — see Subscription.status.
  planCancelRequested Boolean @default(false)
  /// Set the one time a user claims their 30-day free Pro trial (billing.service.startTrial) —
  /// never cleared afterward, purely to block claiming a second one. Independent of plan/
  /// planExpiresAt: a user who later pays for real Pro keeps this timestamp from their original
  /// trial claim, so "have they ever paid" must be checked separately (via Payment, not this
  /// field) by anything that needs to distinguish a trial-granted period from a paid one (e.g.
  /// trial-ending-soon reminder notifications).
  trialStartedAt DateTime?
  /// FREE tier's submit quota resets every calendar month — submitQuotaUsed counts submissions
  /// made in submitQuotaMonth (a "YYYY-MM" key); assertCanSubmit resets both atomically the first
  /// time a user submits in a new month, so there's no separate cron/reset job to keep in sync.
  submitQuotaUsed  Int     @default(0)
  submitQuotaMonth String?
  /// Free-text motto/座右銘 shown on the public profile.
  bio       String  @default("")
  /// Data-URL (base64) avatar image — kept small by client-side resizing/compression before
  /// upload, so no external file storage is needed at this scale. Null shows a generic
  /// initial-letter avatar instead.
  avatarUrl String?
  /// One of TAIWAN_UNIVERSITIES (packages/shared) — a closed set, not free text, so the
  /// leaderboard's school filter and "top student at X" view can group on it exactly. Null until
  /// the user fills out ProfileSetupModal (or Settings) — that step is skippable, and this stays
  /// null for anyone who skips it.
  school    String?
  /// The school email address a verification link was last sent to (or already verified) for the
  /// *current* `school` value. Reset to null whenever `school` changes — a verification only ever
  /// vouches for one specific school claim, never carries over to a newly picked one.
  schoolEmail             String?
  /// Set once the emailed verification link is clicked; null means unverified (either never
  /// requested, or requested but not yet confirmed). Only a non-null value here lets this user be
  /// grouped under `school` on the leaderboard — see leaderboard.service's school filter.
  schoolVerifiedAt        DateTime?
  /// Last time a verification email actually went out, for a simple resend cooldown — unrelated
  /// to schoolVerifiedAt, which only ever reflects a *confirmed* click.
  schoolVerificationTokenHash String?
  schoolVerificationSentAt DateTime?
  schoolDomainRequests SchoolDomainRequest[]
  /// Retired on 2026-09-17. Historical inventory retained for rollback compatibility only;
  /// application code no longer grants, spends or reads it.
  streakFreezeCount      Int     @default(0)
  streakFreezeGrantMonth String?
  /// Daily check-in streak — distinct from the solve-based day streak above: this counts
  /// consecutive calendar days the user has simply visited (see users.service.ts's daily(),
  /// which records it lazily the same way it does everything else here), not days they solved
  /// something. Check-ins do not grant rewards or extend the solve streak.
  loginStreak   Int     @default(0)
  lastLoginDate String?
  /// Set when the user requests account deletion (users.service.deleteAccount) — the account is
  /// logged out and unusable from that moment, but the row itself isn't actually removed until
  /// AccountDeletionReaperService's sweep finds it past ACCOUNT_DELETION_GRACE_MS, giving a short
  /// window to recover from an accidental or malicious deletion request (see cancelDeletion).
  /// Null means no deletion is pending.
  deletionRequestedAt DateTime?
  settings     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions          Submission[]
  contestParticipants  ContestParticipant[]
  discussions          Discussion[]
  posts                Post[]
  createdAssignments   Assignment[]          @relation("AssignmentCreator")
  assignments          AssignmentAssignee[]  @relation("AssignmentAssigneeUser")
  classSessions        ClassSession[]        @relation("ClassSessionStudent")
  createdClassSessions ClassSession[]        @relation("ClassSessionTeacher")
  classComments        ClassComment[]
  notes                Note[]
  payments             Payment[]
  subscriptions        Subscription[]
  pageViews            PageView[]
  achievements         UserAchievement[]
  notifications        Notification[]
  streakFreezeDays      StreakFreezeDay[]
  usedSchoolEmails      UsedSchoolEmail[]
  authChallenges        AuthChallenge[]
  securityEvents        SecurityEvent[]

  @@map("users")
}

/// Only a digest validates a bearer token. The encrypted delivery copy is erased after send.
model AuthChallenge {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose String
  tokenHash String @unique
  tokenEncrypted String?
  targetEmail String
  authVersion Int
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  sentAt DateTime?
  deliveryAttempts Int @default(0)
  nextDeliveryAt DateTime @default(now())
  leaseUntil DateTime?

  @@unique([userId, purpose])
  @@index([sentAt, nextDeliveryAt])
  @@map("auth_challenges")
}

/// Security decisions only; never store passwords, OTPs, bearer tokens or request bodies.
model SecurityEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("security_events")
}

/// Anti-abuse ledger: one row per school email that has ever actually completed verification
/// (confirmSchoolVerification), so the same real @school.edu.tw address can't be used to verify
/// more than one account — without this, a whole dorm could share one classmate's inbox to all
/// claim the same school. Separate from User.schoolEmail (which just holds the *current*, possibly
/// unconfirmed claim and gets reset on a school change) — this row is written once, on confirmed
/// verification, and never touched again, so it survives even if the verifying user later switches
/// schools or deletes their account.
model SchoolDomainRequest {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  school String
  domain String
  officialUrl String
  explanation String
  status String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  decisions SchoolDomainDecision[]
  @@index([userId, createdAt])
  @@index([school, status])
  @@map("school_domain_requests")
}

model SchoolDomainDecision {
  id String @id @default(cuid())
  requestId String
  request SchoolDomainRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId String
  status String
  note String
  createdAt DateTime @default(now())
  @@index([requestId, createdAt])
  @@map("school_domain_decisions")
}

model UsedSchoolEmail {
  /// Lowercased/trimmed — see normalizeSchoolEmail in users.service.ts. The primary key itself is
  /// what makes a second confirmation for the same address fail atomically (unique violation)
  /// rather than needing a separate check-then-write.
  email      String   @id
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  school     String
  verifiedAt DateTime @default(now())

  @@index([userId])
  @@map("used_school_emails")
}

/// Retired streak protection history, preserved for rollback compatibility. These rows no longer
/// contribute to streaks, daily goals, achievements or leaderboard results.
model StreakFreezeDay {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("streak_freeze_days")
}

/// One earned entry per (user, achievement code) — codes are a fixed catalog defined in code
/// (apps/api/src/achievements/catalog.ts), not a DB table, since the set rarely changes and
/// doesn't need admin editing. Evaluated after every AC (see achievements.service.ts).
model UserAchievement {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code     String
  earnedAt DateTime @default(now())

  @@unique([userId, code])
  @@map("user_achievements")
}

/// In-app notification inbox. `type` distinguishes achievement/assignment/etc for icon/styling
/// purposes without needing a DB enum migration to add a new kind. Email is deferred — this is
/// the only delivery channel for now.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

/// A single page load, recorded by a lightweight client-side beacon (see PageviewTracker) for
/// self-hosted traffic analytics. Bot/crawler user agents and known referrer-spam domains are
/// filtered server-side before insertion (see analytics.service.ts recordPageview) — this table
/// should already be clean, not raw unfiltered log data.
model PageView {
  id        String   @id @default(cuid())
  path      String
  /// External referrer only (document.referrer from the browser) — null for direct visits or
  /// same-origin navigation. Already spam-filtered before insertion.
  referrer  String?
  userAgent String?
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([path])
  @@map("page_views")
}

/// One upgrade payment. With manual bank/LINE Pay transfer, the user submits a claim (PENDING)
/// with a reference note, an admin verifies the money arrived and APPROVES (which extends the
/// user's planExpiresAt), or REJECTS. `method` leaves room for an automated gateway (e.g. ECPay)
/// later without changing this table.
model Payment {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  period     BillingPeriod
  amountNtd  Int
  pricingVersion String @default("legacy-v1")
  status     PaymentStatus @default(PENDING)
  method     String        @default("MANUAL")
  reference  String        @default("")
  createdAt  DateTime      @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  paidAt DateTime?
  refundPolicyVersion String @default("first-charge-7d-v1")
  refundDeadlineAt DateTime?
  ecpayTradeNo String? @unique
  cycleNumber Int?
  entitlementStartsAt DateTime?
  entitlementEndsAt DateTime?
  /// The ECPay ChoosePayment channel the user picked on our checkout page ("Credit" | "ATM"),
  /// set only for method=ECPAY. Lets the pending-payment UI show the right message (bank
  /// transfer details vs. "confirming your card") instead of guessing from vAccount presence.
  ecpayMethod String?
  /// ECPay's order id (MerchantTradeNo) — set only for method=ECPAY, used to correlate their
  /// async webhooks back to this row. Unique because ECPay requires every order id we send them
  /// to be unique in the first place.
  merchantTradeNo String? @unique
  /// ATM virtual-account details, filled in by the PaymentInfoURL webhook once ECPay issues the
  /// account (separate from — and earlier than — actual payment confirmation via ReturnURL).
  bankCode   String?
  vAccount   String?
  expireDate String?
  /// Set when the user dismisses their own still-PENDING order from the checkout page (e.g. they
  /// backed out of an ATM transfer they no longer want). Deliberately NOT a status change: ECPay's
  /// webhook (handleEcpayReturn) only ever checks status === PENDING, so a dismissed order can
  /// still auto-approve normally if the user goes ahead and pays it anyway — dismissing only hides
  /// it from the checkout UI and lets them start a fresh order, it never risks silently discarding
  /// a real payment.
  dismissedByUser Boolean @default(false)
  /// Set at order-creation time for ECPay credit-card orders that were submitted with recurring
  /// (定期定額) parameters — tells handleEcpayReturn to spin up a Subscription row once this first
  /// charge is confirmed, instead of treating it as a one-off purchase.
  isRecurring Boolean @default(false)
  /// Set only on the periodic renewal charges themselves (handleEcpayPeriodReturn), not on the
  /// original subscribe order — links each auto-charge back to the subscription for the admin
  /// billing page's audit trail.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([status, createdAt])
  @@index([userId, status])
  @@unique([subscriptionId, cycleNumber])
  @@map("payments")
}

enum RefundRequestStatus {
  REQUESTED
  PROCESSING
  NEEDS_REVIEW
  COMPLETED
}

/// Durable first-purchase refund; userId uniqueness prevents reusing the guarantee.
/// Unknown external outcomes require reconciliation, never a blind repeat of a card action.
model RefundRequest {
  id String @id @default(cuid())
  userId String @unique
  paymentId String @unique
  /// Opaque references survive account removal for transaction audit, without retaining email.
  amountNtd Int
  merchantTradeNo String
  status RefundRequestStatus @default(REQUESTED)
  requestedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  nextAttemptAt DateTime @default(now())
  attempts Int @default(0)
  lastError String?
  /// Written before the external action. A crash with this set needs reconciliation.
  inFlightAction String?
  processingToken String?
  cancellationConfirmedAt DateTime?
  refundConfirmedAt DateTime?
  resolutions RefundResolution[]
  @@index([status, nextAttemptAt])
  @@map("refund_requests")
}

model RefundResolution {
  id String @id @default(cuid())
  requestId String
  request RefundRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  clientRequestId String @unique
  requestHash String
  actorId String
  decision String
  evidenceReference String
  reason String
  previousStatus String
  resultingStatus String
  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@map("refund_resolutions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

/// A recurring ECPay credit-card subscription (信用卡定期定額) — auto-charges `amountNtd` every
/// `period` until cancelled. Distinct from Payment: a Payment row is created for every individual
/// charge (subscribe + each renewal), while this row tracks the subscription itself so it can be
/// looked up by merchantTradeNo when ECPay's periodic webhook or our own cancel call needs it.
model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  period BillingPeriod
  /// The amount charged each cycle, locked in at subscribe time — a later price change should
  /// never silently reprice an existing subscriber.
  amountNtd Int
  /// Immutable checkout terms, copied from the first order and onto every renewal.
  pricingVersion String @default("legacy-v1")
  /// The MerchantTradeNo of the original subscribe order. Required to correlate PeriodReturnURL
  /// renewal webhooks back to this row, and to call ECPay's CreditCardPeriodAction Cancel API.
  merchantTradeNo String             @unique
  status          SubscriptionStatus @default(ACTIVE)
  /// Last-seen ECPay TotalSuccessTimes (cumulative successful-charge count) — ECPay's periodic
  /// webhook gives no other progress marker, so a renewal notification is only processed when its
  /// TotalSuccessTimes is strictly greater than this, making the handler idempotent against retries.
  totalSuccessTimes Int       @default(0)
  createdAt         DateTime  @default(now())
  cancelledAt       DateTime?

  payments Payment[]

  @@index([userId, status])
  @@map("subscriptions")
}

model Problem {
  id            String        @id @default(cuid())
  // The public problem NUMBER everyone knows (e.g. "100" for "The 3n + 1 problem") — used for
  // display, matching, and dedup. This is NOT the id UVa's own submission system expects.
  uvaId         Int?          @unique
  // UVa's own internal problem id (uHunt calls it "pid"), required by the actual submission form.
  // These two ids are unrelated except by coincidence — e.g. public number 100 has internal pid
  // 36, while UVa's own internal id "100" belongs to a completely different problem ("164 -
  // String Computer"). Submitting with uvaId instead of uvaPid silently judges against the wrong
  // problem's test data (discovered via a real WA/AC discrepancy report — every problem in this
  // table had uvaPid != uvaId). Nullable only for the moment right after uvaId is set and before
  // the uHunt lookup backfills it; judgeViaUva refuses to submit without it.
  uvaPid        Int?
  slug          String        @unique
  title         String
  statementMd   String
  sourceUrl     String?
  inputSpecMd   String        @default("")
  outputSpecMd  String        @default("")
  timeLimitMs   Int           @default(1000)
  memoryLimitKb Int           @default(65536)
  difficulty    Int           @default(1)
  // When true, difficulty came from a human-curated source (e.g. the CPE 必考49題 list, which is
  // an official one-star selection) and derivation backfills must never overwrite it.
  difficultyLocked Boolean    @default(false)
  source        ProblemSource @default(CUSTOM)
  checkerType   CheckerType   @default(IGNORE_TRAILING_WS)
  floatEps      Float?
  visibility    Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  samples          Sample[]
  testCases        TestCase[]
  tags             ProblemTag[]
  submissions      Submission[]
  contestProblems  ContestProblem[]
  discussions      Discussion[]
  assignmentLinks  AssignmentProblem[]
  classHomework    ClassHomework[]
  collectionLinks  CollectionProblem[]
  notes            Note[]

  @@index([uvaId])
  @@map("problems")
}

/// A named, curated problem list (LeetCode-style) — e.g. "CPE 必考 49 題". Distinct from Contest:
/// no timer/scoring, just a themed set of problems to work through at your own pace.
model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  // Section header the collections page groups this under (e.g. "考試歷屆", "演算法主題"). Free-text
  // rather than an enum since new groupings will be added ad-hoc as more collections are curated.
  category    String   @default("")
  createdAt   DateTime @default(now())

  problems CollectionProblem[]

  @@map("collections")
}

model CollectionProblem {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  problemId    String
  problem      Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  ord          Int        @default(0)

  @@id([collectionId, problemId])
  @@index([problemId])
  @@map("collection_problems")
}

model Sample {
  id        String  @id @default(cuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  ord       Int
  input     String
  output    String

  @@index([problemId])
  @@map("samples")
}

// Hidden judging data for the local (Vercel Sandbox) judge — distinct from Sample, which is only
// ever shown to users on the problem page. A problem is judged locally instead of relayed to UVa
// the moment it has at least one row here (see ProblemsService.recommendNext-style derivation in
// the judge dispatch, not a separate boolean flag — avoids the flag and the actual data ever
// silently drifting apart).
model TestCase {
  id        String  @id @default(cuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  ord       Int
  input     String
  output    String

  @@unique([problemId, ord])
  @@map("test_cases")
}

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  problems ProblemTag[]

  @@map("tags")
}

model ProblemTag {
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
  @@map("problem_tags")
}

model Submission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  contestId   String?
  contest     Contest? @relation(fields: [contestId], references: [id], onDelete: SetNull)
  /// Which specific attempt (ContestParticipant row) this submission belongs to — a contest can
  /// now have more than one attempt per user (see ContestParticipant.attemptNumber), so contestId
  /// alone is no longer enough to tell which attempt's clock/scoreboard a submission counts
  /// against. Null for pre-migration submissions and anything not made during a contest.
  contestParticipantId String?
  contestParticipant    ContestParticipant? @relation(fields: [contestParticipantId], references: [id], onDelete: SetNull)
  languageKey String
  sourceCode  String
  status      Verdict  @default(PENDING)
  verdict     Verdict  @default(PENDING)
  timeMs      Int?
  memoryKb    Int?
  score       Float    @default(0)
  compileError String?
  judgedOn    JudgedOn @default(REMOTE)
  createdAt   DateTime @default(now())
  judgedAt    DateTime?
  clientRequestId String?
  queuedAt DateTime?
  quotaMonth String?
  quotaRefundedAt DateTime?
  evaluationVersion Int @default(1)
  pendingJudgeResult Json?

  @@index([userId, createdAt])
  @@index([userId, verdict, createdAt])
  @@index([problemId, verdict])
  @@index([contestId, userId, createdAt])
  @@index([contestParticipantId])
  @@index([verdict, createdAt])
  @@index([judgedAt])
  @@unique([userId, clientRequestId])
  @@map("submissions")
}

model Contest {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  kind        ContestKind @default(PUBLIC)
  startAt     DateTime?
  durationMin Int         @default(180)
  freezeMin   Int         @default(60)
  penaltyMin  Int         @default(20)
  scoring     ScoringMode @default(ICPC)
  isPublic    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  /// CPE's own published "average correct count" for this sitting (scraped from the exam listing
  /// page), e.g. 1.55 — a difficulty/pass-rate signal independent of anything our own users do.
  avgCorrectCount Float?
  /// Total real-world exam takers for this sitting (CPE's own published figure, e.g. 2446) —
  /// the denominator behind each ContestProblem's "考生答對率".
  totalCandidates Int?

  problems     ContestProblem[]
  participants ContestParticipant[]
  submissions  Submission[]

  @@map("contests")
}

model ContestProblem {
  contestId String
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  label     String
  ord       Int
  /// Real-world CPE exam stats for this problem in this specific sitting (scraped from the exam
  /// listing page's per-problem stats table — 繳交次數/作答人數/答對人數). Null for the demo contest
  /// and anything not scraped from the real CPE site.
  submissions Int?
  attempted   Int?
  correct     Int?

  @@id([contestId, problemId])
  @@index([problemId])
  @@map("contest_problems")
}

model ContestParticipant {
  id        String            @id @default(cuid())
  contestId String
  contest   Contest           @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1 for a user's first attempt at this contest, 2 for their second, etc. Only individual/
  /// virtual contests (Contest.startAt is null) allow more than one — a scheduled group sitting
  /// still stops at attemptNumber 1 (see ContestsService.register). Re-attempts are only possible
  /// once the previous attempt's endsAt has passed, so a user never has two live attempts at once.
  attemptNumber Int            @default(1)
  scoringVersion String @default("icpc-v2")
  startedAt DateTime          @default(now())
  endsAt    DateTime
  status    ParticipantStatus @default(RUNNING)
  submissions Submission[]

  @@unique([contestId, userId, attemptNumber])
  @@index([userId])
  @@index([contestId, userId])
  @@map("contest_participants")
}

model Discussion {
  id        String   @id @default(cuid())
  problemId String?
  problem   Problem? @relation(fields: [problemId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  publishedAt DateTime?
  deletedAt DateTime?
  revisions ContentRevision[]

  @@index([problemId, createdAt])
  @@index([postId, createdAt])
  @@map("discussions")
}

/// Only approved content lives in title/bodyMd. Pending edits are immutable ContentRevision rows.
model Post {
  id         String   @id @default(cuid())
  title      String
  bodyMd     String
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isOfficial Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   String   @default("GENERAL")
  publishedAt DateTime?
  deletedAt DateTime?
  revisions ContentRevision[]
  comments Discussion[]

  @@index([createdAt])
  @@index([publishedAt, id])
  @@map("posts")
}

enum ContentReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

/// Exactly one target, enforced by a database CHECK. Content never changes after submission;
/// review updates only decision metadata. Target deletion/account erasure cascades the text.
model ContentRevision {
  id String @id @default(cuid())
  postId String?
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  discussionId String?
  discussion Discussion? @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  submittedById String
  title String?
  body String
  category String?
  isOfficial Boolean @default(false)
  status ContentReviewStatus @default(PENDING)
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedById String?
  reason String?

  @@index([status, createdAt, id])
  @@index([postId, createdAt])
  @@index([discussionId, createdAt])
  @@index([submittedById, createdAt])
  @@map("content_revisions")
}

model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  dueAt       DateTime?
  createdById String
  createdBy   User      @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  problems  AssignmentProblem[]
  assignees AssignmentAssignee[]

  @@map("assignments")
}

model AssignmentProblem {
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  problemId    String
  problem      Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  ord          Int        @default(0)

  @@id([assignmentId, problemId])
  @@map("assignment_problems")
}

model AssignmentAssignee {
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("AssignmentAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([assignmentId, userId])
  @@map("assignment_assignees")
}

/// A single lesson/tutoring session for one specific student — "Class 1", "Class 2", ... in that
/// student's own personal sequence (not a shared classroom timeline: two students can both have a
/// "Class 3" with entirely different content, taught on different days, at their own pace).
model ClassSession {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("ClassSessionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation("ClassSessionTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  number    Int
  title     String   @default("")
  contentMd String   @default("") // what was taught that day
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homework ClassHomework[]
  comments ClassComment[]

  @@unique([studentId, number])
  @@map("class_sessions")
}

/// Q&A thread on a class session — the student can ask about that lesson, the teacher/any admin
/// can reply, all in one flat, timestamped list (no nested threading — a class session's comment
/// count is small enough that a simple chronological thread reads fine).
model ClassComment {
  id        String       @id @default(cuid())
  classId   String
  class     ClassSession @relation(fields: [classId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime     @default(now())

  @@index([classId, createdAt])
  @@map("class_comments")
}

model ClassHomework {
  id        String       @id @default(cuid())
  classId   String
  class     ClassSession @relation(fields: [classId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  ord       Int          @default(0)

  @@unique([classId, problemId])
  @@map("class_homework")
}

/// A user's own private notes on a problem — never shown to anyone else.
model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  content   String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([userId, problemId])
  @@map("notes")
}
