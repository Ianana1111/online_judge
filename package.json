{
  "name": "online-judge",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "db:migrate": "pnpm --filter @oj/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @oj/db exec tsx prisma/seed.ts",
    "db:generate": "pnpm --filter @oj/db exec prisma generate",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:runtime": "node scripts/test-api-runtime.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "fast-check": "^4.10.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ],
    "overrides": {
      "multer": "^2.3.0",
      "dompurify": "^3.4.13",
      "postcss": "^8.5.23",
      "fast-uri": "^3.1.6",
      "sharp": "^0.35.4",
      "undici@7": "^7.29.0",
      "nanoid@3": "^3.3.18",
      "browserslist": "^4.28.7",
      "qs": "^6.16.0",
      "baseline-browser-mapping": "^2.11.0"
    }
  }
}
