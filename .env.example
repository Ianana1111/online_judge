# --- Postgres ---
POSTGRES_USER=oj
POSTGRES_PASSWORD=oj_dev_password
POSTGRES_DB=oj
DATABASE_URL=postgresql://oj:oj_dev_password@localhost:5432/oj?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CSRF_SECRET=change_me_csrf_secret_dev_only

# --- Internal service auth (api <-> judge) ---
INTERNAL_SERVICE_TOKEN=change_me_internal_token_dev_only

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Judge worker ---
# Must stay 1: every submission proxies through a single shared UVa bot account, identified by
# "smallest new submission id" (see apps/judge/src/remote/uva.ts) — only unambiguous if
# submissions to UVa go out strictly one at a time. Raising this risks silently misattributing
# verdicts between concurrent UVa-judged submissions, not just a rate-limit/ban risk.
JUDGE_CONCURRENCY=1
API_INTERNAL_URL=http://localhost:4000

# UVa remote judge — see apps/judge/src/remote/README.md before setting these. Use a dedicated
# bot account, never a personal one. A problem with no local TestCase rows is judged this way;
# leave unset and such submissions will just return a "not configured" SE.
UVA_BOT_USERNAME=
UVA_BOT_PASSWORD=

# Local judge (Vercel Sandbox) — see apps/judge/src/local/judge.ts. A problem with at least one
# TestCase row is judged this way instead of relaying to UVa.
# JUDGE_SANDBOX_SNAPSHOT_ID comes from `pnpm --filter @oj/judge exec tsx scripts/build-snapshot.ts`.
# Auth: VERCEL_OIDC_TOKEN for local dev (`vercel env pull` in apps/web, ~12h TTL); in
# production/CI use a real access token instead (VERCEL_TOKEN + VERCEL_TEAM_ID + VERCEL_PROJECT_ID —
# see https://vercel.com/docs/sandbox/concepts/authentication).
JUDGE_SANDBOX_SNAPSHOT_ID=
VERCEL_OIDC_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=

# --- Error tracking (optional) ---
# Leave unset to disable — Sentry.init no-ops safely without a dsn in all three apps (api, judge,
# web). NEXT_PUBLIC_SENTRY_DSN is separate from SENTRY_DSN because it ships into the browser
# bundle; a DSN is a write-only ingest identifier, safe to expose publicly (Sentry's own model).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Judge worker health endpoint (optional) ---
# GET /health on this port reports queue depth and time since the last completed judge — see
# apps/judge/src/health.ts. Defaults to 4100 if unset.
JUDGE_HEALTH_PORT=4100
