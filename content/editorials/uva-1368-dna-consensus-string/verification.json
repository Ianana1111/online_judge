{
  "sources": [
    "https://onlinejudge.org/external/13/1368.pdf"
  ],
  "constraints": [
    "4<=m<=50;4<=n<=1000;ACGTonly;minsumHamming;lexicographicallysmallesttie."
  ],
  "independentMethod": "For every candidate letter compute mismatch count directly against the column, then minimize(cost,letter); tiny full4^n consensus enumeration cross-checks.",
  "oracleFile": "scripts/editorials/oracles/structures.py",
  "mutations": [
    {
      "id": "reverse-tie",
      "label": "Chooses lexicographically larger tie",
      "languageKey": "cpp17",
      "find": "count[k] > count[best]",
      "replace": "count[k] >= count[best]"
    },
    {
      "id": "matches-as-error",
      "label": "Reports matches instead of mismatches",
      "languageKey": "cpp17",
      "find": "error += m - count[best]",
      "replace": "error += count[best]"
    }
  ]
}
