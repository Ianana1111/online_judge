{
  "sources": [
    "https://onlinejudge.org/external/100/10003.pdf"
  ],
  "constraints": [
    "1<=L<1000;0<=N<50;strict increasing0<cuts<L;cost=current segment length;0terminator."
  ],
  "independentMethod": "Optimal ordered merging of final segment lengths, with Knuth-bounded split search; independent segment-index implementation plus exhaustive physical cutting-order enumeration on small cases.",
  "oracleFile": "scripts/editorials/oracles/gpecore.py",
  "mutations": [
    {
      "id": "omit-first-cut",
      "label": "Omits current cut fee",
      "languageKey": "cpp17",
      "find": "cut[right] - cut[left] + dp[left][first]",
      "replace": "dp[left][first]"
    },
    {
      "id": "leftmost-first",
      "label": "Always cuts leftmost point first",
      "languageKey": "cpp17",
      "find": "first < right;",
      "replace": "first < left + 2;"
    }
  ]
}
