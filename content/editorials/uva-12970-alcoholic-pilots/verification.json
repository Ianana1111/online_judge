{
  "sources": [
    "https://onlinejudge.org/external/129/12970.pdf"
  ],
  "constraints": [
    "allv,d1..1e9;no ties;arrival=d/v;average(t1+t2)/2;fourzeroend;reducedfractionnoslashspaces;64bitproducts<=2e18."
  ],
  "independentMethod": "Independent Fraction arrival values compare and average before canonical formatting; cases include pairs differing by one in cross products but indistinguishable in double precision.",
  "oracleFile": "scripts/editorials/oracles/rational_surfaces.py",
  "mutations": [
    {
      "id": "floating-race",
      "label": "Rounds near-equal arrival times with double",
      "languageKey": "cpp17",
      "find": "d1*v2<d2*v1",
      "replace": "double(d1)/v1<double(d2)/v2"
    },
    {
      "id": "sum-not-average",
      "label": "Omits division by two",
      "languageKey": "cpp17",
      "find": "denominator=2*v1*v2",
      "replace": "denominator=v1*v2"
    }
  ]
}
