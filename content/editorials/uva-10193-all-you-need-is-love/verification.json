{
  "sources": [
    "https://onlinejudge.org/external/101/10193.pdf"
  ],
  "constraints": [
    "1<=T<10000;validbinarystringslength2..30;leading1;loveL>=2;commondivisorcriterion."
  ],
  "independentMethod": "Prime-factor set of first value checked against divisibility of second, independent of gcd; small literal repeated-subtraction existence checks.",
  "oracleFile": "scripts/editorials/oracles/integers.py",
  "mutations": [
    {
      "id": "allow-one",
      "label": "Allows invalid one-bit love value",
      "languageKey": "cpp17",
      "find": "> 1;",
      "replace": ">= 1;"
    },
    {
      "id": "both-even",
      "label": "Only recognizes common divisor2",
      "languageKey": "cpp17",
      "find": "gcd(value(a), value(b)) > 1",
      "replace": "value(a) % 2 == 0 && value(b) % 2 == 0"
    }
  ]
}
