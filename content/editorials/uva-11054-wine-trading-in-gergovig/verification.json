  "constraints": [
    "2<=N<=100000;-1000<=a_i<=1000;sum=0;unit distance cost;signed64-bit result;N0 terminator."
  ],
  "independentMethod": "Greedily match the earliest remaining buyer and seller by quantities and positions, summing amount*distance independently of prefix-cut formula.",
  "oracleFile": "scripts/editorials/oracles/textgames.py",
  "mutations": [
    {
      "id": "individual-magnitude",
      "label": "Adds individual demand instead of prefix imbalance",
      "languageKey": "cpp17",
      "find": "work += llabs(balance);",
      "replace": "work += llabs(value);"
    },
    {
      "id": "int-work",
      "label": "Stores work in32bit",
      "languageKey": "cpp17",
      "find": "long long balance = 0, work = 0;",
      "replace": "long long balance = 0; int work = 0;"
    }
  ]
}
